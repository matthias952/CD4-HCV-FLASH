# Define color schemes
timepoint_col <- c("FU" = "#FFC2C2", "SPR" = "#B2DFEE")

# Load activity matrix
activity_eset <- readRDS(".../activity_eset.rds")
activity_matrix <- exprs(activity_eset)

# Load original Seurat object
seurat_obj <- readRDS(
  ".../hcv_flashseq_all.rds")

# Match cells between objects
common_cells <- intersect(colnames(activity_matrix), colnames(seurat_obj))
activity_matrix <- activity_matrix[, common_cells]
seurat_obj <- seurat_obj[, common_cells]

# Clean gene names and add activity assay
rownames(activity_matrix) <- gsub("_TF$", "", rownames(activity_matrix))
seurat_obj[["Activity"]] <- CreateAssayObject(data = activity_matrix)


# Figure G - Differential Activity Analysis
# Pseudobulk activity volcano plot
# Filter for non-naive cells from FU and SPR timepoints
seurat_subset <- subset(seurat_obj, subset = Naive != "Naive" & Timepoint %in% c("FU", "SPR"))

# Get TF driver list to filter for TFs only
hg_driver_symbols <- getDriverList(species_type = "hg", driver_type = "TF")

# Extract activity matrix and filter for TFs
activity_data <- GetAssayData(seurat_subset, assay = "Activity", slot = "data")
activity_data_TF <- activity_data[rownames(activity_data) %in% hg_driver_symbols, ]

print(paste("Number of TFs in analysis:", nrow(activity_data_TF)))

# Create pseudobulk by aggregating cells per patient
metadata <- seurat_subset@meta.data
metadata$cell_id <- rownames(metadata)

# Aggregate activity by Patient and Timepoint
pseudobulk_list <- list()
sample_info <- data.frame()

for(patient in unique(metadata$Patient)) {
  for(timepoint in unique(metadata$Timepoint)) {
    # Get cells for this patient-timepoint combination
    cells <- metadata$cell_id[metadata$Patient == patient & metadata$Timepoint == timepoint]
    
    if(length(cells) > 0) {
      # Calculate mean activity across cells for this patient-timepoint
      sample_name <- paste(patient, timepoint, sep = "_")
      pseudobulk_list[[sample_name]] <- Matrix::rowMeans(activity_data_TF[, cells, drop = FALSE])
      
      # Store sample information
      sample_info <- rbind(sample_info, data.frame(
        Sample = sample_name,
        Patient = patient,
        Timepoint = timepoint,
        n_cells = length(cells)
      ))
    }
  }
}

# Convert to matrix
pseudobulk_matrix <- do.call(cbind, pseudobulk_list)
colnames(pseudobulk_matrix) <- names(pseudobulk_list)

print("Sample information:")
print(sample_info)
print(paste("Pseudobulk matrix dimensions:", paste(dim(pseudobulk_matrix), collapse = " x ")))

# Create design matrix
design_matrix <- model.matrix(~ 0 + Timepoint, data = sample_info)
colnames(design_matrix) <- c("FU", "SPR")
rownames(design_matrix) <- sample_info$Sample

print("Design matrix:")
print(design_matrix)

# Since activity data can be negative and limma-voom expects non-negative values, add the minimum value + 1
min_value <- min(pseudobulk_matrix, na.rm = TRUE)
if(min_value < 0) {
  pseudobulk_matrix_shifted <- pseudobulk_matrix - min_value + 1
  print(paste("Shifted activity values by", -min_value + 1, "to make them positive"))
} else {
  pseudobulk_matrix_shifted <- pseudobulk_matrix
}

# Convert to DGEList object
dge <- DGEList(counts = pseudobulk_matrix_shifted)

# Normalize using TMM (though for activity data, this might not be necessary)
dge <- calcNormFactors(dge)

# Apply voom transformation
v <- voom(dge, design_matrix, plot = TRUE)

# Fit linear model
fit <- lmFit(v, design_matrix)

# Create contrast matrix for SPR vs FU comparison
contrast_matrix <- makeContrasts(
  SPR_vs_FU = SPR - FU,
  levels = design_matrix
)

# Apply contrasts
fit2 <- contrasts.fit(fit, contrast_matrix)
fit2 <- eBayes(fit2)

# Get results
pseudobulk_results <- topTable(fit2, coef = "SPR_vs_FU", number = Inf, sort.by = "P")

# Add significance column
pseudobulk_results$significance <- ifelse(
  (abs(pseudobulk_results$logFC) > 0.25) & (pseudobulk_results$adj.P.Val < 0.05), 
  "Significant", 
  "Not Significant"
)

# Summary of results
print(paste("Total TFs tested:", nrow(pseudobulk_results)))
print(paste("Significant TFs (|logFC| > 0.25 & FDR < 0.05):", 
            sum(pseudobulk_results$significance == "Significant")))

# Add gene names as a column for plotting
pseudobulk_results$Gene <- rownames(pseudobulk_results)

# Create volcano plot for pseudobulk results
genes_to_label_pb <- pseudobulk_results %>% 
  filter(significance == "Significant") %>%
  filter(Gene %in% c("TOX", "TOX2", "STAT4", "BATF", "NFAT5", "EBF1", "ZEB1", "IKZF4", "KDM5A",
                     "ETS1", "KLF9", "RUNX3", "SMAD4", "BCL11B", "POU2F1",
                     "MYC", "KLF3", "STAT2", "LEF1", "IKZF1", "BCLAF1", "KLF6", "ZFP36", "FOXP1",
                     "FOXO3", "STAT1", "STAT6", "STAT5A", "STAT5B", "ID3", "TCF7", "NR4A3",
                     "KDM1A", "IRF7", "CREM", "NFATC2", "JUNB", "CTCF", "NR4A2"))

volcano_plot_pb <- ggplot(pseudobulk_results, aes(x = logFC, y = -log10(adj.P.Val), color = significance)) +
  geom_point(alpha = 0.7, size = 2.5) +
  geom_text_repel(data = genes_to_label_pb, aes(label = Gene), 
                  size = 3.5, color = "black", max.overlaps = 5000, box.padding = 0.5) +
  scale_color_manual(values = c("Significant" = "#E41A1C", "Not Significant" = "grey")) +
  geom_vline(xintercept = c(-0.25, 0.25), linetype = "dashed", color = "grey50") +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed", color = "grey50") +
  labs(title = "Pseudobulk Differential TF Activity: SPR vs FU",
       x = "← Increased in FU | log2(Fold Change) | Increased in SPR →",
       y = "-log10(FDR)") +
  theme_minimal() +
  theme(legend.position = "top", plot.title = element_text(hjust = 0.5, face = "bold"))

print(volcano_plot_pb)

