}

# Read the subset FCS files into a flowSet
fs <- read.flowSet(path = paste0(getwd(),"/subset/"))

# Create patient and sample annotations (metadata)
md <- 
md$date <- 
md$patient <- 
md$condition <- 
md$sample_id <- 
md$patientcondition <- 
md$diffstate <- 


# Convert to factors for CATALYST
md$patient <- factor(md$patient, levels = unique(md$patient))
md$patientcondition <- factor(md$patientcondition, levels = unique(md$patientcondition))
md$condition <- factor(md$condition, levels = unique(md$condition))
md$date <- factor(md$date, levels = unique(md$date))
md$diffstate <- factor(md$diffstate, levels = unique(md$diffstate))

# Create panel annotations
panel <- data.frame(as.character(sub_data_list[[1]]@parameters@data$name),as.character(sub_data_list[[1]]@parameters@data$desc))
rownames(panel) <- c(1:dim(panel)[1])
panel$marker_class <- c("type")
colnames(panel) <- c("fcs_colname", "antigen", "marker_class")
panel[grep("TET|CD4",panel$antigen),]$marker_class <- c("state")
panel[grep("CD45RA",panel$antigen),]$marker_class <- c("type")
panel[grep("FSC.A|SSC.A|Time",panel$fcs_colname),]$marker_class <- c("state")


# Create SCE1 with effector gated subsets
sce1 <- prepData(
  fs,
  panel = panel,
  md = md,
  md_cols = list(file = "file_name", id = "sample_id", factors = c("date", "patient", "condition", "patientcondition", "diffstate")),
  features = panel$fcs_colname,
  transform = TRUE,
  cofactor = 150,
  by_time = F, FACS = T
)

# Add new colData column for identification of cells
expr <- assay(sce, "exprs")
colData(sce)$cell_id <- paste(expr["FSC.A", ], expr["SSC.A", ], sep = "_")

expr1 <- assay(sce1, "exprs")
colData(sce1)$cell_id <- paste(expr1["FSC.A", ], expr1["SSC.A", ], sep = "_")

# Check for dublicates
anyDuplicated(colData(sce)$cell_id)
anyDuplicated(colData(sce1)$cell_id)

# Build a match index from sce IDs to sce1 IDs and join data
m <- match(colData(sce)[["cell_id"]], colData(sce1)[["cell_id"]])

src <- colData(sce1)[["diffstate"]]
colData(sce)$diffstate <- if (is.factor(src)) {
  factor(src[m], levels = levels(src))   # keep same levels
} else {
  src[m]
}

# Check how many are unmatched
n_unmatched <- sum(is.na(m))
message(sprintf("Assigned '%s' to sce; unmatched cells: %d", "diffstate", n_unmatched))

# Assign NAs to Stem-like (since gating was only effector cells)
colData(sce)$diffstate[is.na(colData(sce)$diffstate)] <- "MEM1"

# Run and plot t-SNE on at most 200 cells per sample
set.seed(1277)
sce <- runDR(sce, "TSNE", features = "type", cells = 100)

# Figure 5D left 
figure_5D_left <- plotDR(sce, "TSNE", color_by = "condition",  ncol = 4) + geom_point(size=4) +
  scale_color_manual(values = c("#FF6464", "#B40000", "#FFD2D2", "#FFD2D2", "#FFD2D2",
                                         "#B40000", "#B40000", "#B40000", "#B40000", "#FF6464", "#FF6464"))+
                                           theme(
                                             panel.background = element_rect(fill = "white", color = NA),
                                             plot.background = element_rect(fill = "white", color = NA),
                                             legend.position = "none",  
                                             axis.text.x = element_blank(),  
                                             axis.text.y = element_blank(),  
                                             axis.title.x = element_blank(), 
                                             axis.title.y = element_blank(),
                                             strip.text = element_blank()
                                           )

