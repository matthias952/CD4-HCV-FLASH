# Plot Figure 5E
p <- plotDR(sce, "TSNE", ncol = 4) + 
  geom_point(size = 5, color = "grey90") 

# Build an overlay dataset for the red condition
overlay <- data.frame(
  reducedDim(sce, "TSNE"),
  diffstate = colData(sce)$diffstate,
  condition = colData(sce)$condition
)
names(overlay)[1:2] <- c("TSNE1","TSNE2")

ds_lvls <- levels(overlay$diffstate)
pal <- setNames(scales::hue_pal()(length(ds_lvls)), ds_lvls)

# Add coloured overlay for each condition
condition_totest <- "" #enter condition to plot 

figure_5E <- p +
  geom_point(
    data = subset(overlay, condition == condition_totest),
    mapping = aes(x = TSNE1, y = TSNE2, color = diffstate),
    size = 5.5
  ) +
  scale_color_manual(values = pal, name = "diffstate") +
  coord_equal()+
  theme(
    panel.background = element_rect(fill = "white", color = NA),
