# Figure 4H
# Clones shared BL and FU + cluster 1 and 2 backtracing - exclude clones shared between individuals
meta_data <- subset_hcv.flashseq@meta.data

# Remove rows with missing TCR information
meta_data <- meta_data[!is.na(meta_data$TCRnt) & meta_data$TCRnt != "", ]

# First identify public clones (shared between patients) to exclude them
unique_patients <- unique(meta_data$Patient)
patient_clones <- list()
for(patient in unique_patients) {
  patient_clones[[patient]] <- unique(meta_data$TCRnt[meta_data$Patient == patient])
}

# Find public clones (shared between at least 2 patients)
all_clones <- unique(meta_data$TCRnt)
public_clones <- c()

for(clone in all_clones) {
  patients_with_clone <- sum(sapply(patient_clones, function(x) clone %in% x))
  if(patients_with_clone >= 2) {
    public_clones <- c(public_clones, clone)
  }
}

print(paste("Excluding", length(public_clones), "public clones from analysis"))

# Filter out public clones from the analysis
meta_data_filtered <- meta_data[!meta_data$TCRnt %in% public_clones, ]

print(paste("Cells after excluding public clones:", nrow(meta_data_filtered)))
print(paste("Cells excluded (with public clones):", nrow(meta_data) - nrow(meta_data_filtered)))

# Get unique clones for each condition (now without public clones)
bl_1_clones <- unique(meta_data_filtered$TCRnt[meta_data_filtered$BLclustTime == "BL_1"])
bl_2_clones <- unique(meta_data_filtered$TCRnt[meta_data_filtered$BLclustTime == "BL_2"])
fu_clones <- unique(meta_data_filtered$TCRnt[meta_data_filtered$BLclustTime == "FU"])

# All BL clones combined
all_bl_clones <- unique(c(bl_1_clones, bl_2_clones))

# Categorize clones (now excluding public clones)
unique_bl <- setdiff(all_bl_clones, fu_clones)
unique_fu <- setdiff(fu_clones, all_bl_clones)
shared_bl_fu <- intersect(all_bl_clones, fu_clones)

# For shared clones, determine their BL cluster origin
shared_from_bl1 <- intersect(shared_bl_fu, bl_1_clones)
shared_from_bl2 <- intersect(shared_bl_fu, bl_2_clones)
shared_from_both <- intersect(shared_from_bl1, shared_from_bl2)

# Count cells for each category (using filtered data)
count_cells <- function(clones, condition = NULL) {
  if (is.null(condition)) {
    sum(meta_data_filtered$TCRnt %in% clones)
  } else {
    sum(meta_data_filtered$TCRnt %in% clones & meta_data_filtered$BLclustTime == condition)
  }
}

# Create results table (excluding public clones)
results <- data.frame(
  Category = c(
    "Unique BL (total)",
    "  - from BL_1 only",
    "  - from BL_2 only", 
    "  - from both BL_1 and BL_2",
    "Unique FU",
