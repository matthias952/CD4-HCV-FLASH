# Figure 4J - Shannon diversity
meta <- subset_hcv.flashseq@meta.data
meta_filtered <- meta %>%
  filter(!is.na(TCRnt) & TCRnt != "")
calculate_shannon <- function(tcr_sequences) {
  # Count frequency of each unique TCR
  tcr_counts <- table(tcr_sequences)
  # Calculate Shannon index using vegan package
  shannon_idx <- diversity(tcr_counts, index = "shannon")
  return(shannon_idx)
}
shannon_data <- meta_filtered %>%
  group_by(Timepoint, Patient) %>%
  summarise(
    Shannon = calculate_shannon(TCRnt),
    n_cells = n(),
    n_unique_clones = n_distinct(TCRnt),
    .groups = 'drop'
  )

shannon_data <- shannon_data %>% filter(n_cells >= 10)
shannon_data$Timepoint <- factor(shannon_data$Timepoint, 
                                       levels = c("BL", "FU"))
cluster_colors <- c("BL" ="#B40000",
                    "FU" = "#FFC2C2")
ggplot(shannon_data, aes(x = Timepoint, y = Shannon, fill = Timepoint)) +
  geom_boxplot(outlier.shape = NA, alpha = 0.7) +
  geom_jitter(aes(shape = Patient), width = 0.2, size = 2, alpha = 0.6) +
  scale_fill_manual(values = cluster_colors) +
  theme_classic() +
  labs(
    title = "TCR Shannon Diversity Index by Timpoint",
    x = "Timpoint",
    y = "Shannon Diversity Index"
  ) +
  coord_cartesian(ylim = c(1, 5)) +
  theme(
    legend.position = "right",
    plot.title = element_text(hjust = 0.5, face = "bold"),
    axis.text = element_text(size = 11),
    axis.title = element_text(size = 12, face = "bold")
  )

