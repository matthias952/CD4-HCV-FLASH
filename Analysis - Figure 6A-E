# Functions
prepare_noQC_object <- function(path) {
  obj <- readRDS(file = path)
  obj <- subset(obj, subset = nFeature_RNA > 50 & nFeature_RNA < 5000)
  genes_to_remove <- grep("^(RPL|RPS|MT-)|(^TR[ABDG][VDJ])", rownames(obj), value = TRUE)
  obj <- obj[!rownames(obj) %in% genes_to_remove, ]
  obj <- NormalizeData(obj, normalization.method = "LogNormalize", scale.factor = 10000)
  obj <- subset(obj, subset = CD14 < 0.05 & CD19 < 0.05 & MS4A7 < 0.05 & PPBP < 0.01)
  obj$cells <- paste0(obj$Plate, obj$Well)
  return(obj)
}

run_aucell_gsea <- function(main_seu, no_qc_seu, gmt_path) {
  expr_main <- GetAssayData(main_seu, assay = "RNA", slot = "data")
  expr_no_qc <- GetAssayData(no_qc_seu, assay = "RNA", slot = "data")
  rankings_main <- AUCell_buildRankings(expr_main, plotStats = FALSE)
  rankings_no_qc <- AUCell_buildRankings(expr_no_qc, plotStats = FALSE)
  
  gmt_files <- list.files(gmt_path, pattern = "\\.gmt$", full.names = TRUE)
  
  for (gmt_file in gmt_files) {
    set_name <- tools::file_path_sans_ext(basename(gmt_file))
    gene_vector <- read.gmt(gmt_file) %>% pull(gene) %>% toupper() %>% unique() %>% intersect(rownames(expr_main))
    if (length(gene_vector) == 0) next
    gene_set_list <- list(gene_vector); names(gene_set_list) <- set_name
    
    scores_main <- as.data.frame(t(getAUC(AUCell_calcAUC(gene_set_list, rankings_main)))) %>% rownames_to_column("CellID")
    scores_no_qc <- as.data.frame(t(getAUC(AUCell_calcAUC(gene_set_list, rankings_no_qc)))) %>% rownames_to_column("CellID")
    
    model_data <- no_qc_seu@meta.data %>% rownames_to_column("CellID") %>% left_join(scores_no_qc, by = "CellID")
    lm_model <- lm(model_data[[set_name]] ~ model_data$nFeature_RNA)
    
    adjustment_data <- main_seu@meta.data %>% rownames_to_column("CellID") %>% left_join(scores_main, by = "CellID")
    predicted_scores <- lm_model$coefficients[1] + (adjustment_data$nFeature_RNA * lm_model$coefficients[2])
    main_seu[[paste0("AUCell_adjusted_", set_name)]] <- adjustment_data[[set_name]] - predicted_scores
  }
  
  adjusted_cols <- grep("^AUCell_adjusted_", colnames(main_seu@meta.data), value = TRUE)
  base_names <- unique(gsub("_(UP|DN)$", "", gsub("^AUCell_adjusted_", "", adjusted_cols)))
  
  for (base in base_names) {
    up_col <- paste0("AUCell_adjusted_", base, "_UP")
    down_col <- paste0("AUCell_adjusted_", base, "_DN")
    if (up_col %in% adjusted_cols && down_col %in% adjusted_cols) {
      up_z <- scale(main_seu[[up_col, drop = TRUE]])
      down_z <- scale(main_seu[[down_col, drop = TRUE]])
      main_seu[[paste0("AUCell_composite_", base)]] <- up_z - down_z
    }
  }
  return(main_seu)
}

# Load complete seurat object
subset_hcv.flashseq <- readRDS(file = ".../hcv_flashseq_all.rds")

# Figure 6A - pseudobulk DEG heatmap
variable_meta <- "Timepoint"
counts_matrix <- GetAssayData(subset_hcv.flashseq, slot = "counts")
meta_data <- subset_hcv.flashseq@meta.data %>%
  rownames_to_column("cell_id") %>%
  select(cell_id, Patient, Timepoint)

# Create pseudobulk samples by summing counts per patient per timepoint
pseudobulk_list <- list()
conditions <- unique(meta_data$Timepoint)

# Aggregate counts for each patient-timepoint combination
patient_timepoint_combinations <- meta_data %>%
  select(Patient, Timepoint) %>%
  distinct() %>%
  unite("sample_id", Patient, Timepoint, sep = "_", remove = FALSE)

# Calculate cell counts for each patient-timepoint combination
cell_counts <- meta_data %>%
  group_by(Patient, Timepoint) %>%
  summarise(cell_count = n(), .groups = "drop") %>%
  unite("sample_id", Patient, Timepoint, sep = "_", remove = FALSE)

# Filter for combinations with at least 30 cells
patient_timepoint_combinations <- patient_timepoint_combinations %>%
  inner_join(cell_counts %>% select(sample_id, cell_count), by = "sample_id") %>%
  filter(cell_count >= 30)

# Print number of dropped samples
print(paste("Dropped", sum(cell_counts$cell_count < 30), "samples with fewer than 30 cells"))


# Create pseudobulk count matrix
pseudobulk_counts <- matrix(0, nrow = nrow(counts_matrix), 
                            ncol = nrow(patient_timepoint_combinations))
rownames(pseudobulk_counts) <- rownames(counts_matrix)
colnames(pseudobulk_counts) <- patient_timepoint_combinations$sample_id

# Sum counts for each pseudobulk sample
for(i in 1:nrow(patient_timepoint_combinations)) {
  patient <- patient_timepoint_combinations$Patient[i]
  timepoint <- patient_timepoint_combinations$Timepoint[i]
  
  # Get cells for this patient-timepoint combination
  cells_subset <- meta_data %>%
    filter(Patient == patient & Timepoint == timepoint) %>%
    pull(cell_id)
  
  if(length(cells_subset) > 0) {
    # Sum counts across cells
    pseudobulk_counts[, i] <- rowSums(counts_matrix[, cells_subset, drop = FALSE])
  }
}

# Create pseudobulk metadata
pseudobulk_meta <- patient_timepoint_combinations %>%
  column_to_rownames("sample_id")

pct_expressed <- rowSums(GetAssayData(subset_hcv.flashseq, slot = "counts") > 0) / ncol(subset_hcv.flashseq)
keep_genes_sc <- pct_expressed >= 0.02

# Filter out genes with very low expression across pseudobulk samples
# Keep genes expressed in at least 2 samples with at least 10 counts
keep_genes_pb <- rowSums(pseudobulk_counts >= 20) >= 2
keep_genes <- keep_genes_sc & keep_genes_pb

pseudobulk_counts_filtered <- pseudobulk_counts[keep_genes, ]

print(paste("Retained", nrow(pseudobulk_counts_filtered), "genes for pseudobulk analysis"))
print(paste("Created", ncol(pseudobulk_counts_filtered), "pseudobulk samples"))

# Perform pairwise DEG analysis using DESeq2
combinations <- combn(conditions, 2)
deg_results_list <- list()

for(i in 1:ncol(combinations)) {
  ident1 <- combinations[1, i]
  ident2 <- combinations[2, i]
  
  print(paste("Analyzing:", ident1, "vs", ident2))
  
  # Subset pseudobulk data for this comparison
  samples_subset <- pseudobulk_meta %>%
    filter(Timepoint %in% c(ident1, ident2)) %>%
    rownames()
  
  if(length(samples_subset) < 4) {  # Need at least 2 samples per group
    warning(paste("Insufficient samples for", ident1, "vs", ident2, "comparison"))
    next
  }
  
  counts_subset <- pseudobulk_counts_filtered[, samples_subset]
  meta_subset <- pseudobulk_meta[samples_subset, , drop = FALSE]
  
  # Create DESeq2 object
  dds <- DESeqDataSetFromMatrix(
    countData = counts_subset,
    colData = meta_subset,
    design = ~ Timepoint
  )
  
  # Set reference level
  dds$Timepoint <- relevel(factor(dds$Timepoint), ref = ident2)
  
  # Run DESeq2
  dds <- DESeq(dds, quiet = TRUE)
  
  # Get results
  res <- results(dds, 
                 contrast = c("Timepoint", ident1, ident2),
                 alpha = 0.05)
  
  # Convert to data frame and add metadata
  res_df <- as.data.frame(res) %>%
    rownames_to_column("gene") %>%
    filter(!is.na(padj)) %>%
    mutate(comparison = paste0(ident1, "_vs_", ident2))
  
  deg_results_list[[i]] <- res_df
}

# Combine results
all_deg_results <- bind_rows(deg_results_list)

# Filter results (similar to original but using DESeq2 output)
all_deg_results_sig <- all_deg_results %>%
  filter(padj < 0.05) %>%                    # Adjusted p-value
  #filter(abs(log2FoldChange) >= 1.0) %>%     # Log2 fold change threshold
  filter(!grepl("^TR[ABDG]V", gene)) %>%
  filter(!grepl("^ENSG", gene)) %>%
  arrange(desc(abs(padj))) %>%     # Order by effect size
  distinct(gene) %>%
  slice_head(n = 1000) %>%
  pull(gene)

print(paste("Found", length(all_deg_results_sig), "significant DEGs for heatmap"))

# Create expression matrix for heatmap
expression_matrix <- subset(subset_hcv.flashseq, features = all_deg_results_sig)
expr_data <- GetAssayData(expression_matrix, slot = "data")  
expr_data_scaled <- scale(t(expr_data)) 

# Cluster genes
distance_matrix <- dist(t(expr_data_scaled))
cluster_result <- hclust(distance_matrix, method = "average")
ordered_genes <- rownames(expr_data)[cluster_result$order]

# Pseudobulk heatmap
pseudobulk_expr <- pseudobulk_counts_filtered[all_deg_results_sig, , drop = FALSE]

# Remove any genes with all zeros
pseudobulk_expr <- pseudobulk_expr[rowSums(pseudobulk_expr) > 0, , drop = FALSE]

# Create Seurat object from pseudobulk data
pseudobulk_seurat <- CreateSeuratObject(
  counts = pseudobulk_expr,
  meta.data = pseudobulk_meta,
  project = "PseudobulkDEG"
)

# Normalize the data for visualization
pseudobulk_seurat <- NormalizeData(pseudobulk_seurat, 
                                   normalization.method = "LogNormalize",
                                   scale.factor = 10000)

# Scale data across samples for heatmap
pseudobulk_seurat <- ScaleData(pseudobulk_seurat, features = all_deg_results_sig)

# Create heatmap
DoHeatmap(pseudobulk_seurat, 
          features = ordered_genes,
          group.by = "Timepoint",
          slot = "scale.data") + 
  theme(axis.text.y = element_text(size = 6)) +
  ggtitle("Pseudobulk Heatmap - Standard Scaling")


# Supplemenatry Figure 11A - MDS Plot
# Pseudobulk expression data
avg_expression <- AggregateExpression(subset_hcv.flashseq, group.by = "Timepoint", assays = "RNA")
rna_avg_expression <- avg_expression$RNA

# Perform Multidimensional Scaling (MDS)
