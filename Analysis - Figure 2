create_correlation_barplot <- function(signature_base) {
  
  # Get top 15 genes for this signature
  plot_data <- all_correlations %>%
    filter(Signature == signature_base) %>%
    slice_max(order_by = abs(Correlation), n = 15) %>%
    mutate(
      abs_correlation = abs(Correlation),
      bar_color = ifelse(Correlation < 0, "Negative", "Positive"),
      is_multi = Gene %in% multi_signature_genes,
      gene_color = ifelse(is_multi, "red", "black"),
      gene_face = ifelse(is_multi, "bold", "plain")
    ) %>%
    arrange(abs_correlation)
  
  # Make Gene a factor to preserve order
  plot_data$Gene <- factor(plot_data$Gene, levels = plot_data$Gene)
  
  # Create named vectors for text formatting
  gene_colors <- setNames(plot_data$gene_color, plot_data$Gene)
  gene_faces <- setNames(plot_data$gene_face, plot_data$Gene)
  
  # Create plot
  p <- ggplot(plot_data, aes(x = Gene, y = abs_correlation, fill = bar_color)) +
    geom_bar(stat = "identity") +
    scale_fill_manual(values = c("Negative" = "grey80", "Positive" = "grey30"),
                      name = "Correlation Direction") +
    coord_flip(ylim = c(0, 0.35)) +
    labs(title = paste("Top 15 Genes -", signature_base),
         x = "Gene",
         y = "Absolute Correlation with Composite Score") +
    theme_bw() +
    theme(
      axis.text.y = element_text(colour = gene_colors[levels(plot_data$Gene)],
                                 face = gene_faces[levels(plot_data$Gene)],
                                 size = 9),
      plot.title = element_text(size = 10, face = "bold"),
      legend.position = "bottom"
    )
  
  return(p)
}

# Create bar plots for all signatures
plot_list <- lapply(signature_bases, create_correlation_barplot)

# Display plots
for (i in seq_along(plot_list)) {
  print(plot_list[[i]])
}

# Supplementary figure S5C
# Function to calculate signature overlap with expression filtering
calculate_signature_overlap <- function(seurat_obj, gene_sets_list, signature_bases, 
                                        min_pct_expression = 0) {
  
  # Get expression data
  expr_data <- GetAssayData(seurat_obj, assay = "RNA", slot = "data")
  
  # Calculate percentage of cells expressing each gene
  if (min_pct_expression > 0) {
    pct_expressed <- rowSums(expr_data > 0) / ncol(expr_data) * 100
    expressed_genes <- names(pct_expressed[pct_expressed >= min_pct_expression])
    message(paste("Filtering: Using", length(expressed_genes), 
                  "genes expressed in >=", min_pct_expression, "% of cells"))
  } else {
    expressed_genes <- rownames(expr_data)
  }
  
  # Get combined UP+DOWN genes for each signature
  signature_genes <- list()
  
  for (sig_base in signature_bases) {
    # Get UP and DN gene lists
    up_genes <- gene_sets_list[[paste0(sig_base, "_UP")]]
    dn_genes <- gene_sets_list[[paste0(sig_base, "_DN")]]
    
    # Combine UP and DOWN
    all_genes <- unique(c(up_genes, dn_genes))
    
    # Filter by expression
    expressed_sig_genes <- intersect(all_genes, expressed_genes)
    
    signature_genes[[sig_base]] <- expressed_sig_genes
    
    message(paste(sig_base, ":", length(expressed_sig_genes), 
                  "expressed genes out of", length(all_genes), "total"))
  }
  
  # Calculate overlap matrix
  n_sigs <- length(signature_bases)
  overlap_matrix <- matrix(0, nrow = n_sigs, ncol = n_sigs,
                           dimnames = list(signature_bases, signature_bases))
  
  for (i in 1:n_sigs) {
    for (j in 1:n_sigs) {
      sig1 <- signature_bases[i]
      sig2 <- signature_bases[j]
      
      overlap_genes <- intersect(signature_genes[[sig1]], signature_genes[[sig2]])
      overlap_matrix[i, j] <- length(overlap_genes)
    }
  }
  
  return(list(
    overlap_matrix = overlap_matrix,
    signature_genes = signature_genes
  ))
}

# Function to create overlap heatmap
plot_signature_overlap <- function(overlap_matrix, title_suffix = "") {
  
  # Simplify signature names for plotting
  rownames(overlap_matrix) <- gsub("GSE[0-9]+_", "", rownames(overlap_matrix))
  rownames(overlap_matrix) <- gsub("_VS.*", "", rownames(overlap_matrix))
  colnames(overlap_matrix) <- rownames(overlap_matrix)
  
  # Create heatmap
  pheatmap(overlap_matrix,
           cluster_rows = FALSE,
           cluster_cols = FALSE,
           display_numbers = TRUE,
           number_format = "%.0f",
           color = colorRampPalette(c("white", "lightblue"))(100),
           main = paste("Gene Overlap Between Signatures", title_suffix),
           fontsize = 10,
           fontsize_number = 10,
           angle_col = 45)
}

# Filter: genes expressed in >=10% of cells
