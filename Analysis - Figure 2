                                            gene_sets_list, 
                                            signature_bases, 
                                            min_pct_expression = 10)
plot_signature_overlap(result_10pct$overlap_matrix, "(≥10% cells)")


# Supplementary Figure 7C - shared clones between individuals
meta_data <- subset_hcv.flashseq@meta.data

patient_clones_distinct <- meta_data %>%
  filter(!is.na(TCRnt) & !is.na(Patient)) %>%
  select(TCRnt, Patient) %>%
  distinct()

clone_sharing_summary <- patient_clones_distinct %>%
  group_by(TCRnt) %>%
  summarise(n_patients = n_distinct(Patient), .groups = 'drop') %>%
  mutate(CloneType = ifelse(n_patients > 1, "Shared", "Private"))

total_shared_clones <- clone_sharing_summary %>%
  filter(CloneType == "Shared") %>%
  nrow()

total_private_clones <- clone_sharing_summary %>%
  filter(CloneType == "Private") %>%
  nrow()

cat("Total unique clones (across all patients):", nrow(clone_sharing_summary), "\n")
cat("Total shared/public clones (found in >1 patient):", total_shared_clones, "\n")
cat("Total private clones (found in only 1 patient):", total_private_clones, "\n")

plot_data <- patient_clones_distinct %>%
  left_join(clone_sharing_summary, by = "TCRnt") %>%
  group_by(Patient, CloneType) %>%
  summarise(Count = n(), .groups = 'drop')

plot_data$CloneType <- factor(plot_data$CloneType, levels = c("Private", "Shared"))

ggplot(plot_data, aes(x = Patient, y = Count, fill = CloneType)) +
  geom_bar(stat = "identity", position = "stack") +
  scale_fill_manual(values = c("Private" = "gray70", "Shared" = "darkblue")) +  # darkgreen darkblue
  labs(
    title = "Private vs. Shared Clones by Patient",
    x = "Patient",
    y = "Number of Unique Clones",
    fill = "Clone Type"
  ) +
  theme_classic() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))
