calculate_gene_signature_correlation <- function(seurat_obj, signature_base, gene_sets) {
  
  # Get composite score name
  composite_col <- paste0("AUCell_composite_", signature_base)
  
  if (!composite_col %in% colnames(seurat_obj@meta.data)) {
    warning(paste("Composite score not found:", composite_col))
    return(NULL)
  }
  
  # Get UP and DN gene lists
  up_genes <- gene_sets[[paste0(signature_base, "_UP")]]
  dn_genes <- gene_sets[[paste0(signature_base, "_DN")]]
  
  # Filter genes present in the dataset
  expr_data <- GetAssayData(seurat_obj, assay = "RNA", slot = "data")
  up_genes_present <- intersect(up_genes, rownames(expr_data))
  dn_genes_present <- intersect(dn_genes, rownames(expr_data))
  
  # Get composite scores
  composite_scores <- seurat_obj@meta.data[[composite_col]]
  
  # Calculate correlations for UP genes
  up_correlations <- sapply(up_genes_present, function(gene) {
    gene_expr <- expr_data[gene, ]
    cor(gene_expr, composite_scores, method = "spearman")
  })
  
  # Calculate correlations for DN genes (note: negative correlation expected)
  dn_correlations <- sapply(dn_genes_present, function(gene) {
    gene_expr <- expr_data[gene, ]
    cor(gene_expr, composite_scores, method = "spearman")
  })
  
  # Combine results
  results <- data.frame(
    Gene = c(up_genes_present, dn_genes_present),
    Correlation = c(up_correlations, dn_correlations),
    Direction = c(rep("UP", length(up_genes_present)), 
                  rep("DN", length(dn_genes_present))),
    Signature = signature_base,
    stringsAsFactors = FALSE
  ) %>%
    arrange(desc(abs(Correlation)))
  
  return(results)
}

